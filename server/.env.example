# Set the same token in the Android app's Device Token field.
DEVICE_TOKEN=urbansenseai_demo_token
HOST=0.0.0.0
PORT=8000

# Reverse geocoding for road events (server-side ONLY - never put this in the APK).
# Enable "Geocoding API" in your Google Cloud project, then restrict the key to that API.
# Leave blank to run without addresses: events still carry their coordinates.
GOOGLE_MAPS_API_KEY=

<?xml version="1.0" encoding="utf-8"?>
<!--
    The camera is the app. Everything the perception pipeline needs is in the FIRST
    child below and is unchanged from the standalone detector; the sensor diagnostics
    live in the SECOND child, which DrawerLayout only draws when it is pulled in from
    the right. Closed, this file renders exactly what it rendered before the merge.

    DrawerLayout is from androidx.drawerlayout and is a plain ViewGroup — it needs no
    AppCompat theme and no ActionBar, so the existing platform Material theme and
    ComponentActivity stay as they are.
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ============ MAIN CONTENT: unchanged camera experience ============ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

        <TextView
            android:id="@+id/titleBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="#111111"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/title"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/sensorsButton" />

        <!-- No ActionBar in this theme, so the drawer gets its own affordance. -->
        <Button
            android:id="@+id/sensorsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#111111"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/sensors_button"
            android:textColor="#70D6FF"
            android:textSize="12sp"
            app:layout_constraintTop_toTopOf="@id/titleBar"
            app:layout_constraintBottom_toBottomOf="@id/titleBar"
            app:layout_constraintEnd_toEndOf="parent" />

        <!--
            FIT_CENTER (set in code) letterboxes the camera feed inside this view
            using the same geometry the overlay assumes. Do not change it to
            FILL_CENTER without also changing OverlayView's mapping, or every box
            will be drawn in the wrong place.
        -->
        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/titleBar"
            app:layout_constraintBottom_toTopOf="@id/statusPanel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.roadai.androidtest.OverlayView
            android:id="@+id/overlayView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="@id/previewView"
            app:layout_constraintBottom_toBottomOf="@id/previewView"
            app:layout_constraintStart_toStartOf="@id/previewView"
            app:layout_constraintEnd_toEndOf="@id/previewView" />

        <!-- Latest confirmed/supported road event, over the preview. Hidden until one fires. -->
        <TextView
            android:id="@+id/eventBanner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="#CC1B5E20"
            android:padding="10dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/previewView"
            app:layout_constraintStart_toStartOf="@id/previewView"
            app:layout_constraintEnd_toEndOf="@id/previewView" />

        <LinearLayout
            android:id="@+id/statusPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="#111111"
            android:orientation="vertical"
            android:padding="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: STARTING"
                android:textColor="#DDDDDD"
                android:textSize="12sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/thresholdLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Confidence threshold: 0.25 (both specialists)"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:fontFamily="monospace" />

            <SeekBar
                android:id="@+id/thresholdSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="90"
                android:progress="25" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ============ RIGHT-SIDE DRAWER: sensor diagnostics ============ -->
    <ScrollView
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#0D1220"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:text="@string/sensor_diagnostics"
                android:textColor="#70D6FF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView style="@style/SensorHeading" android:text="@string/hdr_connection" />
            <EditText
                android:id="@+id/receiverUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_receiver"
                android:inputType="textUri"
                android:maxLines="1"
                android:textColor="#E8EEFC"
                android:textColorHint="#5A6B85"
                android:textSize="12sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/connectButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_connect"
                    android:textSize="11sp" />
                <Button
                    android:id="@+id/disconnectButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_disconnect"
                    android:textSize="11sp" />
            </LinearLayout>
            <TextView android:id="@+id/connectionValue" style="@style/SensorValue" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/startButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_start"
                    android:textSize="11sp" />
                <Button
                    android:id="@+id/stopButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_stop"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView style="@style/SensorHeading" android:text="@string/hdr_accel" />
            <TextView android:id="@+id/accelValue" style="@style/SensorValue" />

            <TextView style="@style/SensorHeading" android:text="@string/hdr_gyro" />
            <TextView android:id="@+id/gyroValue" style="@style/SensorValue" />

            <TextView style="@style/SensorHeading" android:text="@string/hdr_gps" />
            <TextView android:id="@+id/gpsValue" style="@style/SensorValue" />

            <TextView style="@style/SensorHeading" android:text="@string/hdr_shock" />
            <TextView android:id="@+id/shockValue" style="@style/SensorValue" />

            <TextView style="@style/SensorHeading" android:text="@string/hdr_events" />
            <TextView android:id="@+id/roadEventValue" style="@style/SensorValue" />

            <TextView style="@style/SensorHeading" android:text="@string/hdr_transmission" />
            <TextView android:id="@+id/transmissionValue" style="@style/SensorValue" />

            <TextView
                android:id="@+id/warningValue"
                style="@style/SensorValue"
                android:textColor="#FFC857" />
        </LinearLayout>
    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
